# Na VPS, use `stat -c %g /var/run/docker.sock` para obter o GID.
MIRA_DOCKER_GID=

# Gere com `openssl rand -hex 32` e guarde o valor apenas no .env local.
MIRA_DOCKER_TOKEN=

# Segredo de assinatura JWT; use um valor aleatório separado do token Docker.
MIRA_JWT_SECRET=

# Conta administrativa inicial, criada apenas quando ainda não há usuários.
MIRA_ADMIN_NAME=Administrador
MIRA_ADMIN_EMAIL=
MIRA_ADMIN_PASSWORD=
